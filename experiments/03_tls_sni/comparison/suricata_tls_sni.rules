# Suricata rule for TLS SNI filtering (Scenario 03).
# Uses Suricata's parsed tls.sni sticky buffer.  `reject` makes Suricata send a
# TCP RST in IPS mode; in PCAP (-r) mode it is logged as an alert.
reject tls any any -> any 443 (msg:"CensorLab exp03 forbidden SNI"; flow:to_server,established; tls.sni; pcre:"/(google\.com|facebook\.com|twitter\.com|youtube\.com|instagram\.com|whatsapp\.com|telegram\.org|signal\.org|wikipedia\.org|reddit\.com|discord\.com|medium\.com|soundcloud\.com|tumblr\.com|vimeo\.com|pinterest\.com|nytimes\.com|washingtonpost\.com|bbc\.com|theguardian\.com|reuters\.com|amnesty\.org|hrw\.org|rsf\.org|torproject\.org|psiphon\.ca|lanternvpn\.org|mullvad\.net|protonvpn\.com|nordvpn\.com|expressvpn\.com|github\.com|gitlab\.com|stackoverflow\.com|twitch\.tv)/i"; sid:3000001; rev:1;)
